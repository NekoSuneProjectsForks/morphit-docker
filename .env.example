# Morphit image published by this repository.
MORPHIT_IMAGE=ghcr.io/nekosuneprojectsforks/morphit

# Use latest to follow the latest successfully built upstream release, or pin
# this to an upstream Morphit release tag for reproducible deployments.
MORPHIT_TAG=latest

# Docker network already attached to Nginx Proxy Manager.
# Find it with:
# docker inspect <npm-container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{println $k}}{{end}}'
NPM_NETWORK=npm_proxy

MORPHIT_CONTAINER_NAME=morphit-web
